N8N_BASE_URL=https://santiagoih1996.app.n8n.cloud
JWT_SECRET=

# Cobranza: sincronización diaria con SIAC (app/api/cron/siac-sync).
# Las credenciales van solo en variables de entorno de Vercel (marcadas como
# Sensitive), nunca en un workflow de n8n ni en el repo.
SIAC_BASE_URL=https://cloud10.siacsoftware.com:8168/ConsultasSIACSuiteJSON.asmx
SIAC_RAZON_SOCIAL=
# La misma clave sirve para todos los servicios; el código la manda como
# ClaveAutentificacion a ListadoCobranzaJSON y como ClaveAutenticacion al resto.
SIAC_CLAVE_AUTENTICACION=
# pruebas | produccion. Todo lo que se guarda queda marcado con este ambiente.
SIAC_AMBIENTE=pruebas
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" al disparar el cron.
CRON_SECRET=
# Incoming Webhook del canal de cobranza en Slack, para avisar si falla la sincronización.
SLACK_COBRANZA_WEBHOOK_URL=

# Cobranza: recordatorios de mora por WhatsApp (Cloud API de Meta), después del cron de las 9:00.
# Token de un usuario del sistema de Meta Business con whatsapp_business_messaging. Sensitive en Vercel.
WHATSAPP_TOKEN=
# El mismo número que usa el flujo "Agente Finbra Cobranza" de n8n.
WHATSAPP_PHONE_NUMBER_ID=
# Opcional: versión de la Graph API (v20.0 por defecto, igual que n8n).
WHATSAPP_API_VERSION=
# ID de la cuenta de WhatsApp Business (WABA), donde viven las plantillas. No es secreto.
# Meta Business → Configuración → Cuentas → Cuentas de WhatsApp. Si falta, se intenta leer del token.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Chat de WhatsApp: el webhook de Meta (app "Finbra Cobranza") apunta a /api/whatsapp/webhook.
# Clave secreta de la app (Meta for Developers → la app → Configuración → Básica). Con ella se verifica
# la firma de cada aviso de Meta. Sensitive en Vercel.
WHATSAPP_APP_SECRET=
# Texto que se inventa al registrar el webhook en Meta ("Token de verificación"); el mismo aquí.
WHATSAPP_VERIFY_TOKEN=
