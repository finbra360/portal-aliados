N8N_BASE_URL=https://santiagoih1996.app.n8n.cloud
JWT_SECRET=

# Cobranza: sincronización diaria con SIAC (app/api/cron/siac-sync).
# Las credenciales van solo en variables de entorno de Vercel (marcadas como
# Sensitive), nunca en un workflow de n8n ni en el repo.
SIAC_BASE_URL=https://cloud10.siacsoftware.com:8168/ConsultasSIACSuiteJSON.asmx
SIAC_RAZON_SOCIAL=
SIAC_CLAVE_AUTENTICACION=
# pruebas | produccion. Todo lo que se guarda queda marcado con este ambiente.
SIAC_AMBIENTE=pruebas
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" al disparar el cron.
CRON_SECRET=
# Incoming Webhook del canal de cobranza en Slack, para avisar si falla la sincronización.
SLACK_COBRANZA_WEBHOOK_URL=
